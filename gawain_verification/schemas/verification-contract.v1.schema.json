{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawain.local/schemas/verification-contract.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_kind",
    "device_id",
    "connection_hint",
    "gateway_endpoint",
    "host_identity",
    "service_id",
    "unit",
    "systemd_scope",
    "action",
    "success_terminal",
    "required_test_cases",
    "required_claims"
  ],
  "properties": {
    "schema_version": {"const": "gawain.verification-contract.v1"},
    "contract_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contract_kind": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "pattern": "^SP[0-9]{6}$"},
    "connection_hint": {"type": "string", "format": "ipv4"},
    "gateway_endpoint": {"type": "string", "format": "ipv4-endpoint"},
    "host_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "service_id": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "systemd_scope": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "success_terminal": {"const": "READY_FOR_HUMAN_ACCEPTANCE"},
    "required_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "required_test_cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required_level", "expected_outcome", "expected_test_count", "oracle"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required_level": {
            "enum": ["unit", "component", "integration", "browser", "tauri", "deployment", "real_device_e2e"]
          },
          "expected_outcome": {"enum": ["PASS", "REJECT"]},
          "expected_test_count": {"type": "integer", "minimum": 1},
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion", "operator", "expected"],
            "properties": {
              "assertion": {"type": "string", "pattern": "\\S"},
              "operator": {"const": "equals"},
              "expected": {"not": {"type": "null"}}
            }
          }
        }
      }
    }
  }
}
