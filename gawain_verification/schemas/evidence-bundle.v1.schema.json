{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawain.local/schemas/evidence-bundle.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "contract",
    "candidate",
    "permit",
    "environment",
    "artifacts",
    "tests",
    "claims",
    "traces",
    "verdict"
  ],
  "properties": {
    "schema_version": {"const": "gawain.evidence-bundle.v1"},
    "run_id": {"type": "string", "pattern": "^run-[A-Za-z0-9._-]+$"},
    "contract": {"type": "object"},
    "candidate": {"type": "object"},
    "permit": {"type": "object"},
    "environment": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "path", "bytes", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required_level",
          "observed_level",
          "expected_outcome",
          "status",
          "command",
          "cwd",
          "environment_fingerprint",
          "expected_test_count",
          "executed_test_count",
          "passed_test_count",
          "failed_test_count",
          "ignored_test_count",
          "exit_code",
          "oracle",
          "evidence"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required_level": {
            "enum": ["unit", "component", "integration", "browser", "tauri", "deployment", "real_device_e2e"]
          },
          "observed_level": {
            "enum": ["unit", "component", "integration", "browser", "tauri", "deployment", "real_device_e2e"]
          },
          "expected_outcome": {"enum": ["PASS", "REJECT"]},
          "status": {"enum": ["PASS", "EXPECTED_REJECT"]},
          "command": {"type": "string", "minLength": 1},
          "cwd": {"type": "string", "minLength": 1},
          "environment_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "expected_test_count": {"type": "integer", "minimum": 1},
          "executed_test_count": {"type": "integer", "minimum": 0},
          "passed_test_count": {"type": "integer", "minimum": 0},
          "failed_test_count": {"type": "integer", "minimum": 0},
          "ignored_test_count": {"type": "integer", "minimum": 0},
          "exit_code": {"type": "integer"},
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion", "operator", "expected", "observed", "passed"],
            "properties": {
              "assertion": {"type": "string", "pattern": "\\S"},
              "operator": {"const": "equals"},
              "expected": {"not": {"type": "null"}},
              "observed": {"not": {"type": "null"}},
              "passed": {"type": "boolean"}
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "claims": {"type": "array"},
    "traces": {"type": "array"},
    "verdict": {"type": "object"},
    "waivers": {"type": "array"},
    "human_acceptance": {"type": "object"},
    "deployment": {"type": "object"}
  }
}
