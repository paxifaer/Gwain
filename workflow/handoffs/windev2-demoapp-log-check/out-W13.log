### 5. skyline `argo_tls.rs` 关键函数 quote

`client_dir()` (argo_tls.rs:116-129):
```rust
pub fn client_dir() -> PathBuf {
    if let Ok(dir) = std::env::var(CLIENT_DIR_ENV) {
        if !dir.trim().is_empty() { return PathBuf::from(dir); }
    }
    let home = std::env::var_os("USERPROFILE")
        .or_else(|| std::env::var_os("HOME"))
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from("."));
    let dir = home.join(".argo-tls");
    tls_log(format!("client_dir resolved dir={}", dir.display()));
    dir
}
```

`has_root_cert()` (argo_tls.rs:85-101,W11 修复）:
```rust
pub fn has_root_cert(app: &AppHandle) -> bool {
    let (_, _, ca_path) = build_cert_paths();
    if ca_path.exists() {
        tls_log(format!("has_root_cert hit=ca_crt path={}", ca_path.display()));
        return true;
    }
    tls_log(format!("has_root_cert miss=ca_crt path={}", ca_path.display()));
    let embedded = load_root_cert(app).is_some();
    tls_log(format!("has_root_cert embedded={embedded}"));
    embedded
}
```

`build_cert_paths()` (argo_tls.rs:103-110)：三元 `dir.join(CLIENT_CERT_NAME/KEY_NAME/CA_NAME)`,`CA_NAME="ca.crt"`。

