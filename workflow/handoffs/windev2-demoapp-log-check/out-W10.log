### 2. `tls_log` 函数完整 body （位于 argo_tls.rs:8-34)

```rust
fn tls_log(msg: impl AsRef<str>) {
    use std::io::Write;
    use std::time::{SystemTime, UNIX_EPOCH};

    let Some(home) =
        std::env::var_os("USERPROFILE").or_else(|| std::env::var_os("HOME"))
    else {
        return;
    };
    let dir = std::path::PathBuf::from(home).join(".argo-tls");
    let _ = std::fs::create_dir_all(&dir);
    let path = dir.join("argo-tls-debug.log");
    let Ok(mut f) = std::fs::OpenOptions::new()
        .create(true)
        .append(true)
        .open(&path)
    else {
        return;
    };
    let ts = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .map(|d| d.as_millis())
        .unwrap_or(0);
    let _ = writeln!(f, "[t={ts}] {}", msg.as_ref());
}
```
与 demo W4 §2 VERBATIM 一致。

