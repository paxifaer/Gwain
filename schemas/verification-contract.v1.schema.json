{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawain.local/schemas/verification-contract.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_kind",
    "device_id",
    "connection_hint",
    "gateway_endpoint",
    "service_id",
    "unit",
    "systemd_scope",
    "action",
    "success_terminal",
    "required_test_cases"
  ],
  "properties": {
    "schema_version": {"const": "gawain.verification-contract.v1"},
    "contract_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contract_kind": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "pattern": "^SP[0-9]{6}$"},
    "connection_hint": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
    },
    "gateway_endpoint": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}:[0-9]{1,5}$"
    },
    "service_id": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "systemd_scope": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "success_terminal": {"const": "READY_FOR_HUMAN_ACCEPTANCE"},
    "required_test_cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
